# AURA local configuration.
# Copy this file to .env to change a value. .env is ignored by git; never commit it.

# AURA listens on this computer only. Other addresses are refused on purpose:
# AURA has no login, so it must not be reachable from the network.
AURA_HOST=127.0.0.1
AURA_PORT=4317

# Where the SQLite database, the secrets file (API key, ChatGPT sign-in),
# automatic backups and logs are stored. Relative to this folder, or an absolute path.
AURA_DATA_DIR=data

# How the launchers (start-aura.bat, start-aura.command, start-aura.sh) open AURA:
#   browser  your default browser (default)
#   app      an app window without tabs or address bar (Microsoft Edge, or Google Chrome on a Mac)
#   none     start the server only
AURA_OPEN=browser

# Minutes without an open AURA window before a server started from the AURA
# icon (Windows) stops by itself. Not used by the launchers.
# AURA_IDLE_EXIT_MIN=20

# Log level: error | warn | info | debug. Logs never contain message text or secrets.
AURA_LOG_LEVEL=info

# Load the removable example data on the very first launch (true/false).
AURA_SEED_DEMO=true

# API keys are not set here: paste yours in Settings > Assistant > API key.
